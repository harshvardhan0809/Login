# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your Supabase values.
# Dashboard -> Project Settings -> API.
#
# THE `VITE_` PREFIX IS A SECURITY BOUNDARY.
#
#   VITE_*  -> compiled into the JavaScript bundle. PUBLIC. Anyone can read it
#              in DevTools. Only ever put the anon/publishable key here.
#   no      -> stays on your machine / your CI. Never reaches the browser.
#   prefix     Secrets and admin config belong here.
#
# Adding a `VITE_` prefix to any value below would publish it to every visitor.
# ---------------------------------------------------------------------------

# --- Public: shipped to the browser ---------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Private: never bundled, used only by `npm run` scripts ---------------

# Service role key. Bypasses Row Level Security completely — treat it like a
# root password. Used only by scripts/promote-admins.mjs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Who gets the admin role. Comma-separated.
#
# Editing this line alone changes nothing — the browser never reads it. It is
# an input to a script that writes roles into the database, and the database is
# what the app checks. Apply a change with:
#
#     npm run admin:promote          (add --dry-run to preview)
#     npm run db:doctor              (show what the database currently thinks)
ADMIN_EMAILS=you@example.com

# Shared secret proving that a Safe Exam Browser check came through
# api/seb-verify on the portal's own domain, rather than being fabricated by the
# page. The browser never sees it. Generate one with:
#
#     openssl rand -hex 32
#
# The SAME value goes in two places, and nowhere else:
#   * this database:  select public.admin_set_seb_secret('<value>');
#   * Vercel:         Project Settings -> Environment Variables -> SEB_PROOF_SECRET
#
# Only needed locally if you run the api/ functions on your own machine
# (`vercel dev`). Until it is set, SEB proofs are simply never recorded and the
# exam behaves as it did before — an unset secret locks nobody out.
SEB_PROOF_SECRET=
