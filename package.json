{
  "name": "exam-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Student exam portal \u2014 tests, results and admin management on Supabase.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-admin-sync.mjs || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "admin:promote": "node scripts/promote-admins.mjs",
    "db:doctor": "node scripts/doctor.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run build",
    "user:purge": "node scripts/purge-user.mjs",
    "db:schema": "sh scripts/build-schema.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "katex": "^0.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
